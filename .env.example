# =============================================================================
# 环境变量样例 —— 复制为 .env.local 后填写真实值
#   cp .env.example .env.local
#   Windows PowerShell: Copy-Item .env.example .env.local
# 严禁把真实密钥提交到仓库（AGENTS.md §8）。
# 校验逻辑见 lib/env.ts；清单说明见 docs/ARCHITECTURE.md §5。
# =============================================================================

# -----------------------------------------------------------------------------
# 【Phase 1 起必填】数据库（PostgreSQL + Drizzle ORM）
# 本地开发：postgres://user:password@localhost:5432/ai_interview
# 线上：Neon / Supabase 提供的连接串（务必带 sslmode=require）
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost:5432/ai_interview"

# -----------------------------------------------------------------------------
# 【Phase 1 起必填】鉴权密钥
# 用途：会话令牌的 HMAC 密钥（lib/auth/session.ts），至少 16 字符。
# 生成：openssl rand -base64 32
# 注意：更换该值会使所有已登录会话立即失效。
# -----------------------------------------------------------------------------
AUTH_SECRET=""

# -----------------------------------------------------------------------------
# 【Phase 2 起必填】对象存储（S3 兼容：Cloudflare R2 / AWS S3 / MinIO）
# 用途：简历与 JD 原件存储（服务端加密）
# 注意：R2 / MinIO 走 path-style 寻址，客户端已固定 forcePathStyle: true
#
# ⚠️ 本地开发不想配 S3 时：设置 STORAGE_DRIVER=local（见文件末尾），
#    上传会写入 .local-storage/ 目录（已忽略），上传链路开箱可用。
#    生产环境**强制**要求 S3_*，未配置会明确报 503，不会静默落本地磁盘。
# -----------------------------------------------------------------------------
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION="auto"

# -----------------------------------------------------------------------------
# 【可选】存储驱动覆盖
#
# STORAGE_DRIVER=local 时强制使用本地文件系统（.local-storage/，仅开发可用）。
# 不设置时的默认行为：
#   - 配了 S3_* → 用 S3
#   - 没配且非生产 → 回退本地文件系统（便于本地跑通全流程）
#   - 没配且是生产 → 抛错并返回 503（Serverless 文件系统不可持久化）
#
# LOCAL_STORAGE_DIR 可自定义本地存储目录（默认 .local-storage）
# -----------------------------------------------------------------------------
# STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR=".local-storage"

# -----------------------------------------------------------------------------
# 【Phase 2 起必填】LLM（OpenAI 兼容接口，支持 DeepSeek / Qwen / GPT）
#
# 简历/JD 解析与匹配分析依赖它；图片走**视觉模型直读**（不做本地 OCR），
# 因此模型必须支持图片输入（如 qwen-vl-max / gpt-4o / deepseek-vl）。
#
# ⚠️ 密钥大小写敏感：DeepSeek 要求小写 `sk-` 前缀，
#    写成 `SK-...` 会得到 401「api key is invalid」。复制密钥时注意别被转换大小写。
#
# ⚠️ 模型选择（重要，直接影响可用性）：
#   - 不要用**推理型**模型（如 deepseek-v4-pro）跑解析/出题：它每次调用都会先产出
#     大量 reasoning token（实测同一份简历 5689 completion token 中 4732 是推理），
#     单次耗时可达 50 秒以上，极易触发超时，且成本高出数倍。
#   - 推荐轻量对话模型（如 deepseek-flash / gpt-4o-mini），本项目实测 0.2~14 秒完成。
#
# 示例：
#   DeepSeek  LLM_BASE_URL="https://api.deepseek.com/v1"                       LLM_MODEL="deepseek-flash"
#   Qwen      LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1" LLM_MODEL="qwen-vl-max"
#   OpenAI    LLM_BASE_URL="https://api.openai.com/v1"                         LLM_MODEL="gpt-4o-mini"
# -----------------------------------------------------------------------------
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""

# -----------------------------------------------------------------------------
# 【可选｜LLM 调优】
#
# LLM_TIMEOUT_MS —— 单次请求超时（默认 120000 = 120 秒）。
#   长输出（出题/报告）与推理型模型需要更长时间；设为 0 或负数会退回默认值。
#
# LLM_MAX_TOKENS_PLAN —— 出题的输出 token 预算（默认 8000）。
#   ⚠️ 这个值不够会导致模型输出被**截断**，JSON 不完整，
#   最终报错「模型返回不是合法 JSON」——看起来像模型不会输出 JSON，
#   实际是预算太小。8-12 道题的 JSON 会超过 4000 token，故默认给 8000。
#   不同供应商上限不同（DeepSeek 实测接受 8192）。
# -----------------------------------------------------------------------------
# LLM_TIMEOUT_MS="120000"
# LLM_MAX_TOKENS_PLAN="8000"

# -----------------------------------------------------------------------------
# 【Phase 3 起必填】ASR（语音转文字）
#
# ⚠️ 供应商选型仍为 TBD（AGENTS.md §9.2）。
# 在此之前，lib/asr 返回「未配置」实现：录音链路完整可用，但服务端会返回
# 503「语音识别暂不可用，请手动输入」，**不会伪造转写文字**。
# 选型确定后新增一个 AsrPort 实现并在 createAsrPort() 中接线即可，前端无需改动。
# -----------------------------------------------------------------------------
ASR_API_KEY=""
ASR_BASE_URL=""

# -----------------------------------------------------------------------------
# 【Phase 7 起必填】支付回调验签密钥
#
# 用途：`POST /api/payments/callback` 的 HMAC-SHA256 验签密钥，至少 16 字符。
# 生成：openssl rand -base64 32
#
# ⚠️ 未配置时：
#   - `POST /api/payments/orders`（下单）返回 503「支付功能尚未开放」
#   - 兑换码渠道仍可用（不依赖此密钥）
#
# 接入真实渠道（Stripe / 微信 / 支付宝）时，把 lib/payments/provider.ts 的
# 签名与报文解析替换为对应实现即可，回调路由的业务逻辑无需改动。
# -----------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# 【可选｜管理后台】是否允许管理员查看用户简历原文
#
# 默认（不设置或非 "true"）：后台**不返回、不渲染** resumes.raw_text 与 parsed_data，
# 只显示文件名、大小、解析状态 —— 满足「不暴露简历原文给无关人员」。
#
# 设为 "true" 后：后台详情页会附带原文，**且每次查看都写入审计日志**
# （action = admin.resume_content_viewed）。仅在有明确客服/排障需求时开启。
# 注意：必须严格为字符串 "true"（大小写敏感，不接受 1/TRUE）。
# -----------------------------------------------------------------------------
# ADMIN_VIEW_RESUME_CONTENT="false"

# -----------------------------------------------------------------------------
# 【可选｜可观测性】
#
# LOG_LEVEL：debug | info | warn | error（默认 info）。
#   日志以单行 JSON 输出，字段经脱敏（不含简历原文、作答、邮箱、令牌）。
#
# SENTRY_DSN：配置后启用外部错误上报（Sentry 兼容 store 接口）。
#   未配置时降级为结构化日志，并在首次出错时提示「监控未启用」。
# -----------------------------------------------------------------------------
# LOG_LEVEL="info"
# SENTRY_DSN=""

# -----------------------------------------------------------------------------
# 【可选】Playwright E2E
#
# 需要两组 seed（由 `pnpm e2e:seed --write` 自动生成并写回 .env.local）：
#   E2E_INTERVIEW_SEED —— 指向「计划已生成、尚未开始」的会话（面试房间用例用）
#   E2E_REPORT_SEED    —— 指向「已完成并已生成报告」的会话（报告/历史用例用）
# 两者**必须是不同会话**：同一会话不可能既「尚未开始」又「已完成」。
#
# E2E_RESET_TOKEN —— 与 dev server 同值；用例前用它调用
#   `/api/test/reset-session` 把会话复位，使用例可重复运行。
#   该接口在生产环境**不存在**（NODE_ENV=production 时直接 404）。
#
# 未配置时相关用例会显式 skip（不会伪装通过）。
# E2E_BASE_URL 默认 http://127.0.0.1:3000
# -----------------------------------------------------------------------------
# E2E_BASE_URL=""
# E2E_INTERVIEW_SEED=""
# E2E_REPORT_SEED=""
# E2E_RESET_TOKEN=""
